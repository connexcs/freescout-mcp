{
    "name": "freescout-mcp/mcp-server",
    "description": "A native stateless MCP server module for FreeScout",
    "type": "freescout-module",
    "license": "AGPL-3.0-or-later",
    "require": {
        "ext-fileinfo": "*",
        "php": "^8.1",
        "mcp/sdk": "0.8.1",
        "nyholm/psr7": "1.8.2",
        "psr/container": "1.0.0",
        "psr/http-client": "1.0.3",
        "psr/http-factory": "1.1.0",
        "psr/http-message": "2.0",
        "psr/log": "1.0.2",
        "symfony/uid": "5.4.45"
    },
    "require-dev": {
        "phpunit/phpunit": "10.5.64"
    },
    "autoload": {
        "psr-4": {
            "Modules\\McpServer\\": ""
        },
        "exclude-from-classmap": [
            "/Database/Migrations/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\McpServer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "bash scripts/lint.sh",
        "test": "phpunit",
        "smoke": "php scripts/protocol-smoke.php",
        "check": [
            "composer validate --no-check-publish",
            "@lint",
            "@test",
            "@smoke"
        ]
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    }
}
